# pydantic-ai model string: provider:model.
# Examples: anthropic:claude-sonnet-4-6 / openai:gpt-5.2 / deepseek:deepseek-v4-pro
#           azure:gpt-5.2 / google:gemini-3-pro / groq:llama-3.3-70b / mistral:mistral-large
#           ollama:llama3.3
# Use 'test' for a keyless fake model (CI uses this).
MODEL=anthropic:claude-sonnet-4-6

# Set the variables for the provider named in MODEL (its client reads them implicitly).
ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#OPENAI_BASE_URL=            # optional, OpenAI-compatible endpoints
#AZURE_OPENAI_ENDPOINT=      # azure needs endpoint AND key
#AZURE_OPENAI_API_KEY=
#OPENAI_API_VERSION=         # optional for azure
#GOOGLE_API_KEY=             # or GEMINI_API_KEY
#GEMINI_API_KEY=
#GROQ_API_KEY=
#MISTRAL_API_KEY=
#DEEPSEEK_API_KEY=
#OLLAMA_BASE_URL=            # e.g. http://host.docker.internal:11434/v1
#OLLAMA_API_KEY=             # optional

# Exa web search (https://exa.ai). Required for live web research;
# MODEL=test never calls it.
EXA_API_KEY=

# Optional: send agent traces (runs, model requests, tool calls) to Logfire.
# Leave empty to disable instrumentation entirely.
LOGFIRE_API_KEY=
